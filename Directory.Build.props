<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <Company>Marconnet Technologies LLC</Company>
    <Product>ImpressionFEA — Closed-Die Impression Forging Simulator</Product>
    <Authors>Marconnet Technologies LLC</Authors>
    <Copyright>© 2026 Marconnet Technologies LLC. Licensed under CC BY-NC 4.0.</Copyright>
    <!-- Release number: bump on every release and add an entry to CHANGELOG.md. Shown in the app title bar. -->
    <Version>0.6.1</Version>
    <!-- Build stamp appended to the informational version (e.g. 0.4.0+20261011.0215) so each build is identifiable. -->
    <SourceRevisionId>$([System.DateTime]::Now.ToString("yyyyMMdd.HHmm"))</SourceRevisionId>
  </PropertyGroup>
</Project>
