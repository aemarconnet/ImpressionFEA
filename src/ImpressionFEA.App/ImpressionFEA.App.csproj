<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ImpressionFEA.Core\ImpressionFEA.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OxyPlot.Wpf" Version="2.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Explorer / taskbar icon of the exe (multi-resolution, built by assets/make-icon.ps1) -->
    <ApplicationIcon>..\..\assets\ImpressionFEA.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Window icon and header logo -->
    <Resource Include="..\..\assets\ImpressionFEA.ico" Link="Assets\ImpressionFEA.ico" />
    <Resource Include="..\..\assets\ImpressionFEA-256.png" Link="Assets\ImpressionFEA-256.png" />
  </ItemGroup>

</Project>
