<Window x:Class="ImpressionFEA.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpressionFEA.App.Controls"
        xmlns:vm="clr-namespace:ImpressionFEA.App.ViewModels"
        xmlns:inf="clr-namespace:ImpressionFEA.App.Infrastructure"
        xmlns:oxy="http://oxyplot.org/wpf"
        Title="ImpressionFEA"
        Width="1560" Height="940" MinWidth="1180" MinHeight="720"
        Icon="pack://application:,,,/Assets/ImpressionFEA.ico"
        Background="{StaticResource WindowBg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <inf:InverseBooleanConverter x:Key="Not" />
        <inf:InverseBooleanToVisibilityConverter x:Key="NotBoolToVis" />
        <inf:NotNullToVisibilityConverter x:Key="NotNullToVis" />
        <Style x:Key="ReadLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Margin" Value="0,3,8,3" />
        </Style>
        <Style x:Key="ReadValue" TargetType="TextBlock" BasedOn="{StaticResource MonoValue}">
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" MinHeight="360" />
            <RowDefinition Height="9" />
            <RowDefinition Height="230" MinHeight="90" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource HeaderBg}">
            <DockPanel Margin="14,0">
                <Image DockPanel.Dock="Left" Source="pack://application:,,,/Assets/ImpressionFEA-256.png" Width="26" Height="26"
                       Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Left" Text="ImpressionFEA" Foreground="{StaticResource HeaderText}" FontWeight="Bold"
                           FontSize="15" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Left" Text="Closed-die impression forging · rigid-viscoplastic FEM" Foreground="#9AA5B1"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Units" Foreground="#9AA5B1" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="86" ItemsSource="{Binding UnitOptions}" SelectedItem="{Binding SelectedUnits}"
                              ToolTip="US: inches, ksi, tonf, °F (3 decimals) · Metric: mm, MPa, t, °C (2 decimals). The solver and CSV files always use mm, MPa, t, °C." />
                    <TextBlock Margin="16,0,0,0" Foreground="#9AA5B1" FontFamily="{StaticResource Mono}" FontSize="11" Text="{Binding EngineName}" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Row="1" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="250" MaxWidth="640" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="400" MinWidth="300" MaxWidth="900" />
            </Grid.ColumnDefinitions>
            <!-- Drag handles between the panels -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to resize" Style="{StaticResource Splitter}" />
            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Background="Transparent" Cursor="SizeWE" ToolTip="Drag to resize" Style="{StaticResource Splitter}" />

            <!-- 1. Input / configuration -->
            <Border Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CONFIGURATION" Style="{StaticResource PanelTitle}" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource PanelBorder}" />
                    <TabControl x:Name="ConfigTabs" Margin="4,6,4,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource PanelBorder}" Background="Transparent">
                        <!-- ============ BASIC ============ -->
                        <TabItem Header="Basic" Padding="14,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,0,8,12">
                                    <!-- Active demo guide -->
                                    <Border Margin="0,8,0,0" Padding="8,6" BorderThickness="1" BorderBrush="{StaticResource Accent}" Background="#EEF4FB"
                                            Visibility="{Binding ActiveDemo, Converter={StaticResource NotNullToVis}}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="✕" Command="{Binding CloseDemoCommand}" Padding="5,0" Background="Transparent"
                                                        BorderThickness="0" ToolTip="Hide the demo guide" />
                                                <TextBlock Text="{Binding ActiveDemo.Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding ActiveDemo.Guide}" TextWrapping="Wrap" FontSize="11.5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel IsEnabled="{Binding CanEdit}">
                                        <TextBlock Text="Analysis" Style="{StaticResource SectionHeader}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                            <RadioButton Content="2D (axisym. / plane strain)" IsChecked="{Binding Analysis2D}" GroupName="Analysis" />
                                            <RadioButton Content="3D solid" IsChecked="{Binding Analysis3D}" GroupName="Analysis" Margin="12,0,0,0" />
                                        </StackPanel>

                                        <TextBlock Text="Geometry" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding DieSets}" SelectedItem="{Binding SelectedDie}"
                                                  Visibility="{Binding Show2DDies, Converter={StaticResource BoolToVis}}" />
                                        <ComboBox ItemsSource="{Binding DieSets3D}" SelectedItem="{Binding SelectedDie3D}"
                                                  Visibility="{Binding Show3DDies, Converter={StaticResource BoolToVis}}" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Import STEP (3 bodies)…" Click="ImportStep_Click" Style="{StaticResource FlatButton}"
                                                    ToolTip="Import a STEP assembly of bottom die, workpiece and top die. The body between the other two (by centre of gravity) is the workpiece; you pick the moving top die." />
                                            <Button Grid.Column="2" Content="Re-import" Click="Reimport_Click" Style="{StaticResource FlatButton}" IsEnabled="{Binding CanReimport}"
                                                    ToolTip="Re-read the STEP file if it changed on disk, keeping the top die and every setting. Shift+click: re-import and solve." />
                                        </Grid>
                                        <Border Margin="0,6,0,0" Padding="8,5" BorderThickness="1" BorderBrush="{StaticResource Warn}" Background="#FFF8EC"
                                                Visibility="{Binding SourceChanged, Converter={StaticResource BoolToVis}}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Re-import &amp; solve" Click="ReimportSolve_Click" Style="{StaticResource FlatButton}" Padding="8,2" />
                                                <TextBlock Text="The STEP file changed on disk." Foreground="{StaticResource Warn}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            </DockPanel>
                                        </Border>
                                        <TextBlock Text="{Binding SourceText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" FontSize="10.5"
                                                   Visibility="{Binding CanReimport, Converter={StaticResource BoolToVis}}" />
                                        <!-- Die-only imports: the user-defined workpiece -->
                                        <Border Margin="0,8,0,2" Padding="8,4,8,8" BorderThickness="1" BorderBrush="{StaticResource PanelBorder}" Background="{StaticResource SectionBg}"
                                                Visibility="{Binding IsUserBillet, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                                <TextBlock Text="Workpiece (you define it)" FontWeight="SemiBold" Margin="0,2,0,4" />
                                                <ComboBox ItemsSource="{Binding WorkpieceShapes}" SelectedItem="{Binding WorkpieceShape}"
                                                          ToolTip="VerticalBar: round bar on end · HorizontalBar: round bar lying flat · Block: rectangular block" />
                                                <StackPanel Visibility="{Binding WorkpieceIsBar, Converter={StaticResource BoolToVis}}">
                                                    <c:NumericField Label="Diameter D" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceDiameterU}" Quantity="Length" Minimum="1" Maximum="2000" Format="{Binding LengthFormat}" />
                                                    <c:NumericField Label="{Binding WorkpieceLengthLabel}" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceLengthU}" Quantity="Length" Minimum="1" Maximum="3000" Format="{Binding LengthFormat}" />
                                                </StackPanel>
                                                <StackPanel Visibility="{Binding WorkpieceIsBlock, Converter={StaticResource BoolToVis}}">
                                                    <c:NumericField Label="Width (x)" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceWidthU}" Quantity="Length" Minimum="1" Maximum="2000" Format="{Binding LengthFormat}" />
                                                    <c:NumericField Label="Depth (y)" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceDepthU}" Quantity="Length" Minimum="1" Maximum="2000" Format="{Binding LengthFormat}" />
                                                    <c:NumericField Label="Height (z)" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceHeightU}" Quantity="Length" Minimum="1" Maximum="2000" Format="{Binding LengthFormat}" />
                                                </StackPanel>
                                                <c:NumericField Label="Rotation about press axis" Unit="°" Value="{Binding WorkpieceAngle}" Quantity="Plain" Minimum="-360" Maximum="360" Format="F1"
                                                                IsEnabled="{Binding WorkpieceCanRotate}" ToolTip="0° = bar / block aligned with x" />
                                                <c:NumericField Label="Position X" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceOffsetXU}" Quantity="Length" Minimum="-2000" Maximum="2000" Format="{Binding LengthFormat}"
                                                                ToolTip="Plan position of the workpiece centre; 0 = centre of the bottom die" />
                                                <c:NumericField Label="Position Y" Unit="{Binding LengthUnit}" Value="{Binding WorkpieceOffsetYU}" Quantity="Length" Minimum="-2000" Maximum="2000" Format="{Binding LengthFormat}" />
                                                <DockPanel Margin="0,6,0,0">
                                                    <Button DockPanel.Dock="Right" Content="Size to cavity +10 %" Command="{Binding SizeWorkpieceFromCavityCommand}"
                                                            Style="{StaticResource FlatButton}" Padding="8,2"
                                                            ToolTip="Keep the diameter (or block plan size) and set the length (or height) to 110 % of the closed cavity volume" />
                                                    <TextBlock Text="{Binding WorkpieceVolumeText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center" />
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Note}" Text="The workpiece is dropped onto the bottom die; the top die starts at first contact." />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding DieDescription}" Style="{StaticResource Note}" />
                                        <TextBlock Text="{Binding SymmetryText}" Style="{StaticResource Note}" />
                                        <StackPanel Visibility="{Binding BilletEditable, Converter={StaticResource BoolToVis}}">
                                            <c:NumericField Label="{Binding RadiusLabel}" Unit="{Binding LengthUnit}" Value="{Binding BilletRadiusU}" Quantity="Length" Minimum="0.5" Maximum="1000" Format="{Binding LengthFormat}" />
                                            <c:NumericField Label="Billet height H" Unit="{Binding LengthUnit}" Value="{Binding BilletHeightU}" Quantity="Length" Minimum="1" Maximum="3000" Format="{Binding LengthFormat}" IsEnabled="{Binding HeightEnabled}" />
                                            <c:NumericField Label="{Binding LengthLabel}" Unit="{Binding LengthUnit}" Value="{Binding BilletLengthU}" Quantity="Length" Minimum="1" Maximum="3000" Format="{Binding LengthFormat}"
                                                            IsEnabled="{Binding LengthEnabled}" ToolTip="Plane strain: out-of-plane length. 3D bar: bar length." />
                                        </StackPanel>
                                        <TextBlock Text="{Binding VolumeText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" />

                                        <TextBlock Text="Material" Style="{StaticResource SectionHeader}" />
                                        <ComboBox ItemsSource="{Binding Materials}" SelectedItem="{Binding SelectedMaterial}" />
                                        <TextBlock Text="σ̄ = C(T)·(ε₀+ε̄)ⁿ·ε̄̇ᵐ, isothermal" Style="{StaticResource Note}" />
                                        <c:NumericField Label="Temperature T" Unit="{Binding TemperatureUnit}" Value="{Binding TemperatureU}" Quantity="Temperature" Minimum="{Binding SelectedMaterial.TMin}" Maximum="{Binding SelectedMaterial.TMax}" Format="F0" />
                                        <c:NumericField Label="Shear friction factor m" Unit="–" Value="{Binding Friction}" Quantity="Plain" Minimum="0" Maximum="1" Format="F2"
                                                        ToolTip="Constant shear friction τ = m·k (0 = frictionless, 1 = sticking)" />
                                        <TextBlock Text="{Binding MaterialText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" />

                                        <TextBlock Text="Mesh" Style="{StaticResource SectionHeader}" />
                                        <c:NumericField Label="Target element size h" Unit="{Binding LengthUnit}" Value="{Binding ElementSizeU}" Quantity="Length" Minimum="0.1" Maximum="50" Format="{Binding FineLengthFormat}" />
                                        <TextBlock Text="{Binding MeshText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" />

                                        <TextBlock Text="Press" Style="{StaticResource SectionHeader}" />
                                        <c:NumericField Label="Ram speed v" Unit="{Binding SpeedUnit}" Value="{Binding RamSpeedU}" Quantity="Length" Minimum="0.01" Maximum="10000" Format="{Binding LengthFormat}" />
                                        <c:NumericField Label="Press capacity" Unit="{Binding LoadUnit}" Value="{Binding PressCapacityU}" Quantity="Load" Minimum="1" Maximum="100000" Format="{Binding LoadInputFormat}" />
                                        <TextBlock Text="{Binding PressText}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" />

                                        <Border Margin="0,12,0,0" Padding="8,6" BorderThickness="1" BorderBrush="{StaticResource Warn}" Background="#FFF8EC"
                                                Visibility="{Binding HasInputWarning, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding InputWarning}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ ADVANCED ============ -->
                        <TabItem Header="Advanced" Padding="14,4">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="8,0,8,12" IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="Increment" Style="{StaticResource SectionHeader}" />
                                    <c:NumericField Label="Stroke increment Δs" Unit="{Binding LengthUnit}" Value="{Binding StrokeIncrementU}" Quantity="Length" Minimum="0.01" Maximum="10" Format="{Binding FineLengthFormat}" />
                                    <TextBlock Style="{StaticResource Note}" Text="Nominal ram travel per increment (≤ 0.4·h). With auto time-stepping the solver shrinks it where needed and grows it back." />

                                    <TextBlock Text="Robustness (3D solver)" Style="{StaticResource SectionHeader}" />
                                    <CheckBox Content="Auto time-stepping" IsChecked="{Binding AutoStep}" Margin="0,4,0,0" />
                                    <TextBlock Style="{StaticResource Note}" Text="After a cutback keep the smaller increment, then grow it back ×1.5 per clean increment." />
                                    <DockPanel Margin="0,6,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="70" ItemsSource="{Binding CutbackChoices}" SelectedItem="{Binding MaxCutbacks}" />
                                        <TextBlock Text="Max cutbacks per increment" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="Halvings tried before remeshing; the smallest increment is Δs / 2ⁿ." />
                                    <DockPanel Margin="0,6,0,0">
                                        <ComboBox DockPanel.Dock="Right" Width="70" ItemsSource="{Binding RefinementChoices}" SelectedItem="{Binding RefinementLevels}" />
                                        <TextBlock Text="Local refinement levels" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Note}" Text="When an increment cannot be recovered by cutbacks and a remesh, the mesh is refined around the failure (die corners, flash) down to h / 2ⁿ. 0 = uniform mesh only." />
                                    <CheckBox Content="Also refine thin flash regions" IsChecked="{Binding RefineThinFlash}" Margin="0,6,0,0" />
                                    <TextBlock Style="{StaticResource Note}" Text="Refines wherever the closed die gap is under 2.5·h. Better flash resolution; more nodes and solve time." />
                                    <c:NumericField Label="Remesh below quality" Unit="–" Value="{Binding RemeshQualityThreshold}" Quantity="Plain" Minimum="0.02" Maximum="0.4" Format="F2"
                                                    ToolTip="Normalised element quality (1 = regular tetrahedron). Lower = fewer remeshes, higher = earlier remeshing." />
                                    <c:NumericField Label="Node budget" Unit="nodes" Value="{Binding MaxNodeCount}" Quantity="Plain" Minimum="1000" Maximum="60000" Format="F0"
                                                    ToolTip="Upper limit for the initial mesh and for local refinement (memory and time grow with it)." />

                                    <TextBlock Text="Nonlinear solver (3D)" Style="{StaticResource SectionHeader}" />
                                    <c:NumericField Label="Max iterations per increment" Unit="" Value="{Binding MaxIterations}" Quantity="Plain" Minimum="5" Maximum="500" Format="F0" />
                                    <c:NumericField Label="Convergence tolerance |Δv|/|v|" Unit="" Value="{Binding Tolerance}" Quantity="Plain" Minimum="1e-9" Maximum="0.01" Format="0.0E+0" />

                                    <TextBlock Text="Linear solver (3D)" Style="{StaticResource SectionHeader}" />
                                    <ComboBox ItemsSource="{Binding Backends}" SelectedItem="{Binding SelectedBackend}" />
                                    <TextBlock Text="{Binding BackendInfo}" Style="{StaticResource Note}" FontFamily="{StaticResource Mono}" FontSize="10.5" />

                                    <Button Content="Reset to recommended" Command="{Binding ResetAdvancedCommand}" Style="{StaticResource FlatButton}"
                                            HorizontalAlignment="Left" Margin="0,14,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- ============ DEMOS ============ -->
                        <TabItem Header="Demos" Padding="14,4">
                            <DockPanel Margin="8,8,8,8">
                                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="Load demo" Click="LoadDemo_Click" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanEdit}" />
                                        <Button Grid.Column="2" Content="Run its multi-run…" Click="DemoSweep_Click" Style="{StaticResource FlatButton}" IsEnabled="{Binding CanEdit}"
                                                ToolTip="Load the demo, then open Multi-run with the demo's suggested sweep" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Note}" Margin="0,8,0,0" TextWrapping="Wrap">
                                        <Run Text="Demos are JSON files (setup + instructions + suggested sweep). Add or edit them in" />
                                        <Hyperlink Click="OpenDemoFolder_Click"><Run Text="samples/demos" /></Hyperlink>
                                        <Run Text="and press" />
                                        <Hyperlink Command="{Binding ReloadDemosCommand}"><Run Text="Reload" /></Hyperlink><Run Text="." />
                                    </TextBlock>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding Demos}" SelectedItem="{Binding SelectedDemo}" BorderBrush="{StaticResource PanelBorder}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="LoadDemo_Click">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,5,2,7">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Level}" Foreground="{StaticResource Accent}" FontSize="11" />
                                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <!-- 3. Results viewport -->
            <Border x:Name="ResultsPanel" Grid.Column="2" Style="{StaticResource Panel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="10,5,10,5">
                        <TextBlock DockPanel.Dock="Left" Text="RESULTS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <ComboBox DockPanel.Dock="Left" Width="230" ItemsSource="{Binding Fields}" SelectedItem="{Binding SelectedField}" />
                        <ComboBox DockPanel.Dock="Left" Width="78" Margin="6,0,0,0" ItemsSource="{Binding AveragingOptions}" SelectedItem="{Binding Averaging}"
                                  Visibility="{Binding IsGrainFlow, Converter={StaticResource NotBoolToVis}}"
                                  ToolTip="Nodal: element values averaged to the nodes (smooth contours). Element: each element in one flat colour from its own value (no averaging; shows jumps between elements)." />
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="12,0,0,0">
                            <RadioButton Content="2D section" IsChecked="{Binding Is2D}" GroupName="ViewMode" VerticalAlignment="Center"
                                         IsEnabled="{Binding Analysis2D}" />
                            <RadioButton Content="3D solid" IsChecked="{Binding Is3D}" GroupName="ViewMode" VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <!-- View panel: every display setting in one live-updating popup -->
                        <ToggleButton x:Name="ViewToggle" DockPanel.Dock="Right" Content="View ▾" Padding="10,3" Margin="12,0,0,0"
                                      ToolTip="Bodies, transparency, lighting, cut-away, mesh edges, die contact and flow arrows (changes apply live)" />
                        <Popup PlacementTarget="{Binding ElementName=ViewToggle}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                               IsOpen="{Binding IsChecked, ElementName=ViewToggle}" PopupAnimation="Fade" HorizontalOffset="-250">
                            <Border Background="White" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Padding="12,8,12,12" Width="320" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <StackPanel>
                                    <StackPanel.Resources>
                                        <Style TargetType="Slider">
                                            <Setter Property="Margin" Value="0,2,0,4" />
                                            <Setter Property="IsMoveToPointEnabled" Value="True" />
                                        </Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="Margin" Value="0,3,0,3" />
                                        </Style>
                                    </StackPanel.Resources>

                                    <TextBlock Text="Workpiece colours" Style="{StaticResource SectionHeader}" Margin="0,2,0,2" />
                                    <CheckBox Content="Colour map of the result field" IsChecked="{Binding ColorMap}"
                                              ToolTip="Off: show the workpiece deforming as a plain solid, without contour colours" />

                                    <!-- 3D view -->
                                    <StackPanel Visibility="{Binding Is3D, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Bodies" Style="{StaticResource SectionHeader}" Margin="0,2,0,2" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding PartOpacity, StringFormat={}{0:P0}}" />
                                            <CheckBox Content="Workpiece" IsChecked="{Binding PartVisible}" />
                                        </DockPanel>
                                        <Slider Minimum="0.05" Maximum="1" Value="{Binding PartOpacity}" ToolTip="Workpiece opacity" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding TopDieOpacity, StringFormat={}{0:P0}}" />
                                            <CheckBox Content="Top die" IsChecked="{Binding TopDieVisible}" />
                                        </DockPanel>
                                        <Slider Minimum="0.05" Maximum="1" Value="{Binding TopDieOpacity}" ToolTip="Top die opacity" IsEnabled="{Binding TopDieVisible}" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding BottomDieOpacity, StringFormat={}{0:P0}}" />
                                            <CheckBox Content="Bottom die" IsChecked="{Binding BottomDieVisible}" />
                                        </DockPanel>
                                        <Slider Minimum="0.05" Maximum="1" Value="{Binding BottomDieOpacity}" ToolTip="Bottom die opacity" IsEnabled="{Binding BottomDieVisible}" />

                                        <TextBlock Text="Layout" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                        <CheckBox Content="Four views: Top · Isometric · Front · Right" IsChecked="{Binding QuadView}"
                                                  ToolTip="Orthographic Top (top-left), Front (bottom-left) and Right (bottom-right) views with the interactive isometric view top-right" />

                                        <TextBlock Text="Lighting" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                        <ComboBox ItemsSource="{Binding LightingOptions}" SelectedItem="{Binding Lighting}"
                                                  ToolTip="Uniform = ambient only, no shading (colours match the colour bar); Soft / Shaded add a headlight" />

                                        <TextBlock Text="Cut-away" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Left" Content="Section through" IsChecked="{Binding CutAway}" VerticalAlignment="Center" />
                                            <ComboBox Width="52" Margin="8,0,0,0" ItemsSource="{Binding CutAxisOptions}" SelectedItem="{Binding CutAxis}" IsEnabled="{Binding CutAway}"
                                                      ToolTip="Normal of the section plane: Y = front / back cut, X = left / right cut" />
                                            <CheckBox Content="Flip" IsChecked="{Binding CutFlip}" Margin="10,0,0,0" VerticalAlignment="Center" IsEnabled="{Binding CutAway}"
                                                      ToolTip="Remove the other side" />
                                        </DockPanel>
                                        <DockPanel IsEnabled="{Binding CutAway}">
                                            <TextBlock DockPanel.Dock="Left" Text="Offset" Width="52" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding CutOffset, StringFormat={}{0:P0}}" VerticalAlignment="Center" />
                                            <Slider Minimum="-1" Maximum="1" Value="{Binding CutOffset}" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                    ToolTip="Section plane position, as a fraction of the half-width (0 = through the press axis)" />
                                        </DockPanel>

                                        <TextBlock Text="Display" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                        <CheckBox Content="Element edges (surface triangles of the tetrahedra)" IsChecked="{Binding ShowEdges}"
                                                  ToolTip="The 3D mesh is 4-node tetrahedra; on the surface you see their triangular faces, often four around a vertex (a pyramid pattern from the BCC lattice the mesher uses)" />
                                        <CheckBox Content="Die contact (amber bottom · magenta top)" IsChecked="{Binding ShowContact}" />
                                        <CheckBox Content="Die edges (outline the die geometry)" IsChecked="{Binding ShowDieEdges}"
                                                  ToolTip="Thin dark lines on the sharp edges of the dies (creases of the die geometry, cut faces), so the dies read even when the shading is flat or translucent" />
                                    </StackPanel>

                                    <!-- 2D section -->
                                    <StackPanel Visibility="{Binding Is2D, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Section" Style="{StaticResource SectionHeader}" Margin="0,2,0,2" />
                                        <CheckBox Content="Element mesh (4-node quadrilaterals)" IsChecked="{Binding ShowMesh}" />
                                        <CheckBox Content="Mirror about the axis" IsChecked="{Binding Mirror}" />
                                        <CheckBox Content="Die contact (amber bottom · magenta top)" IsChecked="{Binding ShowContact}" />
                                    </StackPanel>

                                    <!-- Grain flow settings (both views), while Grain flow is the selected result -->
                                    <StackPanel Visibility="{Binding IsGrainFlow, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="Grain flow" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="Fibre" Width="52" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                            <ComboBox ItemsSource="{Binding FiberOptions}" SelectedItem="{Binding FlowFiber}"
                                                      ToolTip="Fibre direction of the bar stock in the billet: Auto = along a horizontal 3D bar, otherwise along the press axis; Vertical = bar standing along the press axis (upsetting); Horizontal = bar lying across it (along x in 3D)" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,0">
                                            <TextBlock DockPanel.Dock="Left" Text="Lines" Width="52" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                            <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding FlowLineCount}" VerticalAlignment="Center" />
                                            <Slider Minimum="4" Maximum="60" Value="{Binding FlowLineCount}" TickFrequency="1" IsSnapToTickEnabled="True"
                                                    ToolTip="Number of fibre lines across the billet" />
                                        </DockPanel>
                                        <TextBlock Text="3D: section the part (Cut-away) to see the lines on the cut face." TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Is3D, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <!-- Flow arrows (both views) -->
                                    <TextBlock Text="Flow arrows" Style="{StaticResource SectionHeader}" Margin="0,8,0,2" />
                                    <CheckBox Content="Show material velocity arrows" IsChecked="{Binding ShowVelocity}"
                                              ToolTip="In 3D the part is drawn as a ghost so the arrows inside are visible" />
                                    <DockPanel IsEnabled="{Binding ShowVelocity}">
                                        <TextBlock DockPanel.Dock="Left" Text="Density" Width="52" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        <TextBlock DockPanel.Dock="Right" Text="sparse" Width="40" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="11" />
                                        <Slider Minimum="0.6" Maximum="4" Value="{Binding ArrowSpacing}" ToolTip="Arrow spacing in element sizes: left = dense, right = sparse" />
                                    </DockPanel>
                                    <DockPanel IsEnabled="{Binding ShowVelocity}">
                                        <TextBlock DockPanel.Dock="Left" Text="Size" Width="52" VerticalAlignment="Center" Foreground="{StaticResource Muted}" />
                                        <TextBlock DockPanel.Dock="Right" Width="40" TextAlignment="Right" Text="{Binding ArrowScale, StringFormat={}{0:F1}×}" VerticalAlignment="Center" />
                                        <Slider Minimum="0.3" Maximum="3" Value="{Binding ArrowScale}" ToolTip="Arrow length and thickness" />
                                    </DockPanel>

                                    <Button Content="Reset view" Command="{Binding ResetViewCommand}" Style="{StaticResource FlatButton}" Padding="10,2"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Border />
                    </DockPanel>
                    <Border Grid.Row="1" Background="{StaticResource PanelBorder}" />
                    <c:FieldViewport x:Name="View2D" Grid.Row="2" Snapshot="{Binding DisplaySnapshot}" Die="{Binding ActiveDie2D}"
                                     Field="{Binding SelectedField.Field}" FieldTitle="{Binding FieldTitle}"
                                     RangeMin="{Binding RangeMin}" RangeMax="{Binding RangeMax}" ShowField="{Binding ShowFieldColors}"
                                     ShowMesh="{Binding ShowMesh}" Mirror="{Binding Mirror}" ShowContact="{Binding ShowContact}" ShowVelocity="{Binding ShowVelocity}" Units="{Binding SelectedUnits}" FlowLines="{Binding DisplayFlowLines}" Averaging="{Binding Averaging}"
                                     ArrowSpacing="{Binding ArrowSpacing}" ArrowScale="{Binding ArrowScale}" ClipLow="{Binding ClipLow}" ClipHigh="{Binding ClipHigh}"
                                     ViewBounds="{Binding ViewBounds}" Visibility="{Binding Is2D, Converter={StaticResource BoolToVis}}" />
                    <c:SolidViewport3D x:Name="View3D" Grid.Row="2" Snapshot="{Binding DisplaySnapshot}" ShowEdges="{Binding ShowEdges}" ShowDieEdges="{Binding ShowDieEdges}" Averaging="{Binding Averaging}" GrainFlow="{Binding IsGrainFlow}" FlowLines="{Binding DisplayFlowLines}" FlowField="{Binding DisplayFlowField3D}" FlowFiber="{Binding ResolvedFiber}" FlowLineCount="{Binding FlowLineCount}" Lighting="{Binding Lighting}" ShowVelocity="{Binding ShowVelocity}" ShowContact="{Binding ShowContact}" Units="{Binding SelectedUnits}"
                                       PartVisible="{Binding PartVisible}" PartOpacity="{Binding PartOpacity}" BottomDieVisible="{Binding BottomDieVisible}"
                                       TopDieVisible="{Binding TopDieVisible}" BottomDieOpacity="{Binding BottomDieOpacity}" TopDieOpacity="{Binding TopDieOpacity}" QuadView="{Binding QuadView}" CutAxis="{Binding CutAxis}" CutFlip="{Binding CutFlip}"
                                       CutOffset="{Binding CutOffset}" ArrowSpacing="{Binding ArrowSpacing}" ArrowScale="{Binding ArrowScale}"
                                       ClipLow="{Binding ClipLow}" ClipHigh="{Binding ClipHigh}" Die="{Binding ActiveDie2D}" Die3D="{Binding ActiveDie3D}" Bounds3D="{Binding Bounds3D}"
                                       Field="{Binding SelectedField.Field}" FieldTitle="{Binding FieldTitle}"
                                       RangeMin="{Binding RangeMin}" RangeMax="{Binding RangeMax}" ShowField="{Binding ShowFieldColors}"
                                       CutAway="{Binding CutAway}" ShowDies="{Binding ShowDies}" PartLength="{Binding ShownPartLength}"
                                       ViewBounds="{Binding ViewBounds}" Visibility="{Binding Is3D, Converter={StaticResource BoolToVis}}" />
                    <Border Grid.Row="3" Background="{StaticResource PanelBorder}" />
                    <Grid Grid.Row="4" Margin="10,6,10,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="RAM DESCENT / STEP" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" />
                        <TextBlock HorizontalAlignment="Right" Text="{Binding ScrubText}" FontFamily="{StaticResource Mono}" FontSize="11" />
                        <DockPanel Grid.Row="1" Margin="0,4,0,0">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                                        <Setter Property="FontSize" Value="12" />
                                        <Setter Property="Padding" Value="7,4" />
                                        <Setter Property="Margin" Value="0,0,3,0" />
                                        <Setter Property="FontWeight" Value="Normal" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button Content="&#xE892;" Command="{Binding FirstCommand}" ToolTip="First increment" />
                                <Button Content="&#xE76B;" Command="{Binding StepBackCommand}" ToolTip="Previous increment" />
                                <Button Content="{Binding PlayGlyph}" Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayTip}" Padding="10,4" />
                                <Button Content="&#xE76C;" Command="{Binding StepForwardCommand}" ToolTip="Next increment" />
                                <Button Content="&#xE893;" Command="{Binding LastCommand}" ToolTip="Last increment" />
                                <ToggleButton Content="&#xE8EE;" IsChecked="{Binding LoopPlayback}" FontFamily="Segoe MDL2 Assets" Padding="7,4" Margin="2,0,3,0"
                                              ToolTip="Loop playback" />
                                <ComboBox ItemsSource="{Binding PlaybackRates}" SelectedItem="{Binding PlaybackRate}" Width="52" Margin="2,0,10,0"
                                          ToolTip="Playback speed: increments per second" />
                            </StackPanel>
                            <Slider Minimum="0" Maximum="{Binding ScrubMaximum}" Value="{Binding ScrubIndex}" VerticalAlignment="Center"
                                    IsEnabled="{Binding CanScrub}" IsSnapToTickEnabled="True" TickFrequency="1" SmallChange="1" LargeChange="10"
                                    IsMoveToPointEnabled="True" />
                        </DockPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- 4. Telemetry -->
            <Border x:Name="TelemetryPanel" Grid.Column="4" Style="{StaticResource Panel}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="TELEMETRY" Style="{StaticResource PanelTitle}" />
                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource PanelBorder}" />
                    <Grid DockPanel.Dock="Bottom" Margin="12,8,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Ram stroke" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ReadStroke}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="1" Text="Die gap to closure" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReadGap}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="2" Text="Press load" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReadLoad}" Style="{StaticResource ReadValue}" FontWeight="Bold" />
                        <TextBlock Grid.Row="3" Text="Peak load to this step" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReadPeak}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="4" Text="Cavity fill" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ReadFill}" Style="{StaticResource ReadValue}" FontWeight="Bold" />
                        <TextBlock Grid.Row="5" Text="Max von Mises stress" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReadVonMises}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="6" Text="Max effective strain" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ReadStrain}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="7" Text="Volume change" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ReadVolume}" Style="{StaticResource ReadValue}" />
                        <TextBlock Grid.Row="8" Text="Mesh" Style="{StaticResource ReadLabel}" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ReadMesh}" Style="{StaticResource ReadValue}" />
                    </Grid>
                    <Border DockPanel.Dock="Bottom" Height="1" Background="{StaticResource PanelBorder}" />
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" MinHeight="150" />
                            <RowDefinition Height="7" />
                            <RowDefinition Height="200" MinHeight="90" />
                        </Grid.RowDefinitions>
                    <oxy:PlotView x:Name="LoadChart" Grid.Row="0" Model="{Binding LoadPlot}" Margin="4" Background="Transparent" />
                        <GridSplitter Grid.Row="1" Height="7" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                                      ResizeBehavior="PreviousAndNext" Background="Transparent" Cursor="SizeNS" ToolTip="Drag to resize chart and run list" Style="{StaticResource Splitter}" />
                    <!-- Run history: every finished run, overlaid on the chart when ticked -->
                    <DockPanel Grid.Row="2" Margin="10,2,10,6">
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock Text="RUNS" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <StackPanel.Resources>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Padding" Value="8,2" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Margin" Value="4,0,0,0" />
                                    </Style>
                                </StackPanel.Resources>
                                <Button Content="Multi-run…" Click="MultiRun_Click" IsEnabled="{Binding CanEdit}"
                                        ToolTip="Run the current setup for several values of one parameter (temperature, friction, ram speed, …)" />
                                <Button Content="Save CSV…" Click="SaveTelemetry_Click" IsEnabled="{Binding HasRuns}"
                                        ToolTip="Save the selected run's telemetry (one row per increment) as CSV, plus its setup" />
                                <Button Content="Save all…" Click="SaveAllTelemetry_Click" IsEnabled="{Binding HasRuns}"
                                        ToolTip="Save every run's telemetry and a summary.csv into a folder" />
                                <Button Content="Show/hide" Command="{Binding ShowAllRunsCommand}" ToolTip="Show or hide all overlays" />
                                <Button Content="Reset" Command="{Binding ResetCommand}"
                                        ToolTip="Start fresh: clear every run, the chart overlays, the current results and the log (setup inputs are kept)" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding SweepText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="11"
                                   Margin="0,3,0,0" Visibility="{Binding IsSweeping, Converter={StaticResource BoolToVis}}" />
                        <Grid>
                            <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding SelectedRun}" Margin="0,4,0,0" BorderBrush="{StaticResource PanelBorder}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                     KeyDown="Runs_KeyDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Tip}" Background="Transparent">
                                            <DockPanel.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Delete run" InputGestureText="Del" Click="DeleteRun_Click"
                                                              ToolTip="Remove this run's telemetry, chart overlay and results" />
                                                </ContextMenu>
                                            </DockPanel.ContextMenu>
                                            <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsShown}" VerticalAlignment="Center" ToolTip="Overlay on the chart" />
                                            <Rectangle DockPanel.Dock="Left" Width="12" Height="3" Fill="{Binding Swatch}" Margin="2,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontFamily="{StaticResource Mono}" FontSize="10.5" Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" FontSize="11.5" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="Finished runs appear here. Tick a run to overlay its load and fill curves; use Multi-run to sweep temperature, friction or speed."
                                       TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11" Margin="10,14,10,0" IsHitTestVisible="False"
                                       Visibility="{Binding HasRuns, Converter={StaticResource NotBoolToVis}}" />
                        </Grid>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="9" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                      Background="Transparent" Cursor="SizeNS" ToolTip="Drag to resize the solver log" Style="{StaticResource Splitter}" />

        <!-- Bottom block: the execution bar keeps its height; the log takes whatever the drag handle gives it. -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <!-- 2. Execution & status bar -->
        <Border Grid.Row="0" Margin="8,0,8,0" Style="{StaticResource Panel}" Padding="8,6">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left" Content="Solve FEA Simulation" Command="{Binding SolveCommand}" Style="{StaticResource PrimaryButton}" />
                <Button DockPanel.Dock="Left" Content="Abort" Command="{Binding AbortCommand}" Style="{StaticResource FlatButton}" Margin="6,0,0,0" />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource PanelBorder}" Margin="10,2" />
                <Button DockPanel.Dock="Left" Content="Open setup…" Click="OpenSetup_Click" Style="{StaticResource FlatButton}" IsEnabled="{Binding CanEdit}"
                        ToolTip="Open a saved setup (*.ifea.json): geometry or STEP file, material and every setting" />
                <Button DockPanel.Dock="Left" Content="Save setup…" Click="SaveSetup_Click" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                        ToolTip="Save every input (including the STEP file path and top die) to reopen or rerun later" />
                <Button DockPanel.Dock="Left" Content="Import STEP…" Click="ImportStep_Click" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                        IsEnabled="{Binding CanEdit}" ToolTip="Import a 3-body STEP assembly (bottom die, workpiece, top die)" />
                <Button DockPanel.Dock="Left" Content="Re-import" Click="Reimport_Click" Style="{StaticResource FlatButton}" Margin="6,0,0,0"
                        IsEnabled="{Binding CanReimport}" ToolTip="Re-read the STEP file if it changed, keeping every setting (Shift+click: re-import and solve)" />
                <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource PanelBorder}" Margin="12,2" />
                <Border x:Name="StateLamp" DockPanel.Dock="Left" Width="10" Height="10" VerticalAlignment="Center" Background="{StaticResource Muted}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RunState.Running}">
                                    <Setter Property="Background" Value="{StaticResource Accent}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RunState.Completed}">
                                    <Setter Property="Background" Value="{StaticResource Ok}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RunState.Aborted}">
                                    <Setter Property="Background" Value="{StaticResource Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:RunState.Failed}">
                                    <Setter Property="Background" Value="{StaticResource Danger}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
                <TextBlock DockPanel.Dock="Left" Text="{Binding State}" FontWeight="SemiBold" Margin="6,0,12,0" VerticalAlignment="Center" Width="74" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding ElapsedText}" FontFamily="{StaticResource Mono}" FontSize="14"
                           VerticalAlignment="Center" Margin="12,0,4,0" ToolTip="Execution time" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding StepText}" FontFamily="{StaticResource Mono}" VerticalAlignment="Center"
                           Margin="12,0,0,0" Width="130" TextAlignment="Right" />
                <ProgressBar DockPanel.Dock="Right" Width="200" Height="10" Value="{Binding Progress, Mode=OneWay}" Maximum="100"
                             Foreground="{StaticResource Accent}" Background="{StaticResource SectionBg}" BorderBrush="{StaticResource PanelBorder}" />
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" Margin="0,0,12,0" />
            </DockPanel>
        </Border>

        <!-- Live solver log -->
        <Border Grid.Row="1" Margin="8,6,8,8" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" Background="{StaticResource LogBg}">
            <TextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" Foreground="{StaticResource LogText}" BorderThickness="0"
                     FontFamily="{StaticResource Mono}" FontSize="11.5" Padding="8,6" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" IsUndoEnabled="False" />
        </Border>

        <!-- Export, in the bottom-right corner of the window (over the log, clear of its scroll bars); the menu opens upwards -->
        <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,30,30" Content="Export ▾" Click="Export_Click"
                Style="{StaticResource FlatButton}" Padding="12,4" IsEnabled="{Binding HasResults}"
                ToolTip="Save an image, a video of the ram descent, the deformed part (STL / PLY) or a full report">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Save image (PNG)…" Click="SaveImage_Click" />
                    <MenuItem Header="Save video of the ram descent (WebM)…" Click="SaveVideo_Click" />
                    <MenuItem Header="Save deformed part (STL / PLY)…" Click="SaveSurface_Click" />
                    <Separator />
                    <MenuItem Header="Generate report (all outputs)…" Click="Report_Click" FontWeight="SemiBold" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        </Grid>
    </Grid>
</Window>
